# Zkopíruj do .env.local (lokálně) nebo .env (na serveru vedle docker-compose.yml)
# a doplň skutečné hodnoty. Tento soubor se commituje — nikdy sem nedávej reálné klíče.

# --- Anthropic API ---
# Klíč získáš na https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high — kolik přemýšlení má model do rozpadu vložit
ANTHROPIC_EFFORT=medium

# --- Demo režim ---
DEMO_RATE_LIMIT_PER_HOUR=15
DEMO_MOCK=false

# --- Databáze ---
# Heslo si vymyslíš, nikde se nedohledává. Vygeneruj si ho třeba takhle:
#   openssl rand -hex 24
# Použij jen písmena a číslice — heslo se vkládá do URL a znaky jako @ : / ?
# by ji rozbily.
POSTGRES_PASSWORD=zmen_me
POSTGRES_USER=almostthere
POSTGRES_DB=almostthere

# DATABASE_URL v Dockeru NENASTAVUJ — docker-compose.yml si ji poskládá
# z hodnot výše, takže heslo píšeš jen jednou. Odkomentuj jen pro lokální
# vývoj mimo Docker (např. když spouštíš prisma proti vlastnímu Postgresu):
# DATABASE_URL=postgresql://almostthere:zmen_me@localhost:5432/almostthere?schema=public

# --- Aplikace ---
# Port na serveru, na kterém bude aplikace poslouchat (jen na localhost,
# ven ji pouští nginx). Změň, když na serveru běží víc projektů a 3000
# už je obsazený. Volný port najdeš přes: ss -tlnp | grep :3000
APP_PORT=3000

# Veřejná adresa. Ovlivňuje jen robots.txt a sitemap.xml a zapéká se do buildu,
# takže po změně je potřeba přestavět image. Dokud nemáš doménu, klidně nech
# IP serveru nebo výchozí hodnotu — aplikace funguje i tak.
NEXT_PUBLIC_APP_URL=https://almostthere.app
