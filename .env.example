# Zkopíruj do .env.local (lokálně) nebo .env (na serveru vedle docker-compose.yml)
# a doplň skutečné hodnoty. Tento soubor se commituje — nikdy sem nedávej reálné klíče.

# --- Anthropic API ---
# Klíč získáš na https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high — kolik přemýšlení má model do rozpadu vložit
ANTHROPIC_EFFORT=medium

# --- Demo režim ---
DEMO_LIMIT_PER_DAY=5
DEMO_GLOBAL_LIMIT_PER_DAY=200
DEMO_MOCK=false

# --- Databáze ---
# Heslo si vymyslíš, nikde se nedohledává. Vygeneruj si ho třeba takhle:
#   openssl rand -hex 24
# Použij jen písmena a číslice — heslo se vkládá do URL a znaky jako @ : / ?
# by ji rozbily.
POSTGRES_PASSWORD=zmen_me
POSTGRES_USER=almostthere
POSTGRES_DB=almostthere

# DATABASE_URL v Dockeru NENASTAVUJ — docker-compose.yml si ji poskládá
# z hodnot výše, takže heslo píšeš jen jednou. Odkomentuj jen pro lokální
# vývoj mimo Docker (např. když spouštíš prisma proti vlastnímu Postgresu):
# DATABASE_URL=postgresql://almostthere:zmen_me@localhost:5432/almostthere?schema=public

# --- Autentizace ---
# Podpisový klíč pro sessions. Na každém prostředí JINÝ, vygeneruj si vlastní:
#   node -e "console.log(require('node:crypto').randomBytes(33).toString('base64'))"
# Změna klíče odhlásí všechny přihlášené uživatele.
AUTH_SECRET=

# Google Cloud Console → Clients → OAuth client (typ Web application).
# Do Authorized redirect URIs patří https://<domena>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Na serveru compose dopočítá AUTH_URL z NEXT_PUBLIC_APP_URL a nastaví
# AUTH_TRUST_HOST — za nginxem by si NextAuth adresu sám neodvodil.

# --- Odesílání e-mailů (Resend) ---
# Potřeba pro ověření adresy a reset hesla. Doména odesílatele musí být
# v Resendu ověřená (SPF a DKIM záznamy v DNS).
RESEND_API_KEY=
EMAIL_FROM=AlmostThere <noreply@almost-there.eu>

# --- Platby (Stripe) ---
# Developers → API keys. Testovací klíče začínají sk_test_ / pk_test_.
STRIPE_SECRET_KEY=
# Podpisové tajemství webhooku (whsec_...). Vzniká při založení endpointu
# v Developers → Webhooks, nebo ho vypíše `stripe listen` při lokálním testu.
STRIPE_WEBHOOK_SECRET=
# ID cen z Products → tvůj produkt. Testovací a ostrý režim mají jiná.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Aplikace ---
# Port na serveru, na kterém bude aplikace poslouchat (jen na localhost,
# ven ji pouští nginx). Změň, když na serveru běží víc projektů a 3000
# už je obsazený. Volný port najdeš přes: ss -tlnp | grep :3000
APP_PORT=3000

# Veřejná adresa. Ovlivňuje jen robots.txt a sitemap.xml a zapéká se do buildu,
# takže po změně je potřeba přestavět image. Dokud nemáš doménu, klidně nech
# IP serveru nebo výchozí hodnotu — aplikace funguje i tak.
NEXT_PUBLIC_APP_URL=https://almostthere.app

# Šifrování obsahu cílů v databázi. Vygeneruj: openssl rand -base64 32
# POZOR: po změně klíče se stará data nepřečtou. Ulož si ho i mimo server.
ENCRYPTION_KEY=

# Heslo k šifrování záloh. Vygeneruj: openssl rand -base64 32
# Bez něj zálohu nikdo neobnoví — ulož si ho jinam než na tenhle server.
BACKUP_PASSPHRASE=
BACKUP_DIR=/var/backups/almostthere
BACKUP_KEEP_DAYS=14
