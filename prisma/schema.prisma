// Datový model AlmostThere.
//
// Odpovídá bodu 5 zadání, rozšířenému o entity, které jsou potřeba pro
// právní a provozní část (souhlasy, sledování spotřeby AI, demo cíle).
//
// Ve fázi "landing + demo" se databáze ještě nepoužívá — schéma je tu proto,
// aby další vrstva (registrace, platby, plné cíle) měla na čem stavět a
// aby bylo od začátku vidět, kam produkt míří.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Adresa je v prisma.config.ts (CLI) a v src/lib/db.ts (běh aplikace).
}

// ---------------------------------------------------------------------------
// Uživatel a předplatné
// ---------------------------------------------------------------------------

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

enum SubscriptionStatus {
  NONE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionSource {
  STRIPE
  APPLE
  GOOGLE_PLAY
  /// Přístup přidělený provozovatelem — testeři, výherci, blízcí.
  /// Neplatí se za něj, ale limity použití platí stejně jako u ostatních.
  COMPLIMENTARY
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  passwordHash  String? // null u OAuth účtů
  authProvider  AuthProvider @default(CREDENTIALS)
  name          String?
  /// Profilový obrázek z OAuth. NextAuth ho očekává pod tímhle názvem.
  image         String?

  // Předplatné
  subscriptionStatus SubscriptionStatus  @default(NONE)
  subscriptionSource SubscriptionSource?
  // Externí identifikátory pro párování webhooků
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  appleOriginalTxId    String? @unique
  googlePurchaseToken  String? @unique
  subscriptionEndsAt   DateTime?
  /// Předplatné je vypovězené a doběhne koncem období. Do té doby
  /// přístup platí — zaplacené období se neukrajuje.
  subscriptionCancelAtPeriodEnd Boolean @default(false)
  /// Proč byl přístup přidělen ručně — „tester“, „výherce soutěže“.
  /// Za rok si to nikdo nepamatuje a bez poznámky nejde poznat,
  /// který účet se má nechat a který zrušit.
  subscriptionNote     String?

  // Preference (zadání 5) — vstupují do AI promptu při plánování
  restFrequency         RestFrequency @default(ONE_DAY_PER_WEEK)
  reflectionMinutesDay  Int           @default(10)
  dailyCapacityMinutes  Int           @default(60)
  timezone              String        @default("Europe/Prague")
  locale                String        @default("en")

  /// Od kdy jsou přihlášení platná.
  ///
  /// Přihlášení nosí uživatel v podepsaném tokenu, který server nedokáže
  /// odvolat. Po změně hesla se tahle značka posune a všechny dřív vydané
  /// tokeny tím ztratí platnost — jinak by ukradené přihlášení přežilo
  /// změnu hesla o třicet dní.
  sessionsValidFrom DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete pro retenční politiku; skutečný výmaz řeší GDPR job.
  deletedAt DateTime?

  goals          Goal[]
  checkIns       CheckIn[]
  consents       Consent[]
  aiUsage        AiUsageEvent[]
  passwordResets PasswordResetToken[]
  accounts       Account[]
  sessions       Session[]

  @@index([subscriptionStatus])
}

// --- Modely vyžadované NextAuth --------------------------------------------
// Tvar je daný adaptérem, ne námi — názvy polí měnit nelze.

/// Propojení účtu s externím poskytovatelem (Google). U přihlášení
/// e-mailem a heslem žádný Account nevzniká.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Používá se jen při databázových sessions. Držíme ho kvůli možnosti
/// přepnout z JWT na databázové sessions bez migrace.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Jednorázové tokeny — ověření e-mailové adresy.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum RestFrequency {
  NONE
  ONE_DAY_PER_WEEK
  TWO_DAYS_PER_WEEK
  EVERY_OTHER_DAY
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Záznam souhlasu s obchodními podmínkami a zpracováním osobních údajů.
/// Uchováváme verzi dokumentu a čas — bez toho je souhlas neprokazatelný.
model Consent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  version   String
  granted   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum ConsentType {
  TERMS
  PRIVACY
  ANALYTICS_COOKIES
  MARKETING_COOKIES
}

// ---------------------------------------------------------------------------
// Cíle a hierarchie plánu
// ---------------------------------------------------------------------------

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime
  status      GoalStatus @default(ACTIVE)

  /// Váha pro harmonizaci více cílů — kolik z denní kapacity smí cíl brát.
  priorityWeight Int @default(50)

  /// Barva, kterou je cíl označený napříč aplikací.
  ///
  /// Ukládá se název z palety, ne konkrétní odstín — vzhled se pak dá
  /// doladit bez migrace dat a barvy zůstanou vzájemně sladěné.
  color String @default("lime")

  /// Jazyk, ve kterém je plán napsaný.
  ///
  /// Drží se u cíle, ne u uživatele: plán se dopisuje po částech měsíce
  /// i roky a nesmí se v půlce přepnout do jiného jazyka jen proto, že si
  /// člověk mezitím přepnul rozhraní. Zároveň je to jistota u účtů z Googlu,
  /// kde uživatele zakládá adaptér a preferenci jazyka nezná.
  locale String @default("en")

  // --- Co k plánu řekla AI při rozpadu -------------------------------------
  // Uživatel to musí vidět, jinak neví, na čem plán stojí a proč vypadá,
  // jak vypadá. Bez toho je z plánu neprůhledný příkaz.

  /// Jak AI cíl pochopila — kontrola, že se rozumíme.
  restatement String?
  /// Předpoklady, ze kterých plán vychází (dostupný čas, výchozí úroveň…).
  assumptions String[] @default([])
  /// comfortable | realistic | ambitious | unrealistic
  feasibility     String?
  feasibilityNote String?

  /// Kdy byl cíl dotažen. Podle toho se počítá, jak dlouho to trvalo.
  completedAt DateTime?
  /// Závěrečné shrnutí od AI. Ukládá se, aby bylo pokaždé stejné —
  /// vzpomínka, která se při každém otevření mění, není vzpomínka.
  completionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeBlocks   TimeBlock[]
  tasks        Task[]
  milestones   Milestone[]
  replanEvents ReplanEvent[]
  images       GoalImage[]

  @@index([userId, status])
}

/// Obrázek, který uživatele k cíli motivuje. U denního checklistu se
/// z nich jeden ukazuje — čím víc jich vloží, tím pestřejší to má.
///
/// Samotný soubor leží na disku, v databázi je jen odkaz. Obrázky mohou
/// být osobní, takže se neservírují přímo webserverem, ale přes aplikaci,
/// která ověří, že patří přihlášenému uživateli.
model GoalImage {
  id     String @id @default(cuid())
  goalId String
  /// Cesta v úložišti, relativní ke kořeni pro nahrané soubory.
  storageKey String @unique
  width      Int
  height     Int
  byteSize   Int
  /// Popisek pro čtečky obrazovky. Uživatel ho zadat může, nemusí.
  alt String?

  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

enum BlockLevel {
  /// Nejvyšší úroveň u dlouhých cílů. Desetiletý cíl se na měsíce
  /// rozpadat nemá — je to drahé a stejně se to celé přepočítá.
  YEAR
  MONTH
  WEEK
  DAY
}

/// Uzel v hierarchii plánu. Self-reference přes parentBlockId:
/// měsíc → týdny → dny.
model TimeBlock {
  id            String     @id @default(cuid())
  goalId        String
  level         BlockLevel
  startDate     DateTime   @db.Date
  endDate       DateTime   @db.Date
  /// Krátký štítek do přehledu, pár slov.
  title         String?
  /// Co má být na konci bloku hotové.
  summary       String
  parentBlockId String?
  /// Pořadí v rámci rodiče (měsíc 1, 2, 3…; týden 1, 2…).
  position      Int        @default(0)

  createdAt DateTime @default(now())

  goal       Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  parent     TimeBlock?  @relation("BlockHierarchy", fields: [parentBlockId], references: [id], onDelete: Cascade)
  children   TimeBlock[] @relation("BlockHierarchy")
  tasks      Task[]
  milestones Milestone[]

  @@index([goalId, level])
  @@index([parentBlockId])
}

enum TaskType {
  ACTION
  REST
  REFLECTION
}

enum TaskStatus {
  PENDING
  DONE
  SKIPPED
}

model Task {
  id          String     @id @default(cuid())
  /// Denní blok, do kterého úkol patří.
  timeBlockId String
  goalId      String
  title       String
  description String?
  type        TaskType   @default(ACTION)
  status      TaskStatus @default(PENDING)
  /// Odhad délky v minutách — vstup do rozpočtu dne napříč cíli.
  estimatedMinutes Int?
  completedAt DateTime?
  position    Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeBlock TimeBlock @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([timeBlockId])
  @@index([goalId, status])
}

enum RewardSource {
  USER
  AI_SUGGESTED
}

model Milestone {
  id          String   @id @default(cuid())
  goalId      String
  timeBlockId String?
  title       String
  targetDate  DateTime @db.Date

  rewardText    String?
  rewardSource  RewardSource?
  rewardClaimed Boolean       @default(false)
  achievedAt    DateTime?

  createdAt DateTime @default(now())

  goal      Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  timeBlock TimeBlock? @relation(fields: [timeBlockId], references: [id], onDelete: SetNull)

  @@index([goalId])
}

/// Denní souhrn plnění — vstup pro vyhodnocení tempa.
model CheckIn {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  tasksCompleted Int
  tasksTotal     Int
  note           String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum ReplanReason {
  BEHIND_SCHEDULE
  AHEAD_OF_SCHEDULE
  MANUAL
  USER_DECLINED_REPLAN
}

enum ReplanScope {
  /// „Jen časově“ — obsah zůstává, mění se rozvržení v čase.
  SCHEDULE_ONLY
  /// „Celkově“ — cíl se rozpadne znovu od aktuálního stavu.
  FULL_REDECOMPOSITION
  /// Uživatel přeplánování odmítl; ukládáme kvůli pozdějšímu kontextu.
  NONE
}

model ReplanEvent {
  id            String       @id @default(cuid())
  goalId        String
  reason        ReplanReason
  scope         ReplanScope  @default(NONE)
  oldTargetDate DateTime?
  newTargetDate DateTime?
  /// Co a proč se změnilo — uživatel to musí vidět.
  aiSummary     String?
  completionRate Float?

  triggeredAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, triggeredAt])
}

// ---------------------------------------------------------------------------
// Provoz: spotřeba AI a demo cíle
// ---------------------------------------------------------------------------

enum AiOperation {
  DEMO_MONTHLY
  /// Rozpad nově založeného cíle na nejvyšší úroveň.
  ///
  /// Vlastní hodnota schválně: podle počtu těchhle záznamů se počítá
  /// měsíční limit nových plánů. Záznam přežije smazání cíle, takže limit
  /// nejde obejít tím, že se cíle zakládají a hned mažou.
  DECOMPOSE_GOAL
  DECOMPOSE_MONTHLY
  DECOMPOSE_WEEKLY
  DECOMPOSE_DAILY
  PACE_CHECK
  REPLAN
  REWARD_SUGGESTION
  /// Závěrečné shrnutí při dotažení cíle.
  GOAL_COMPLETED
}

/// Jeden záznam na volání AI. Součet za kalendářní měsíc slouží
/// k vyhodnocení stropu spotřeby (zadání 9).
model AiUsageEvent {
  id           String      @id @default(cuid())
  userId       String?
  operation    AiOperation
  model        String
  inputTokens  Int
  outputTokens Int
  /// Odhad nákladů v haléřích, ať se nepočítá s plovoucí desetinnou čárkou.
  costHellers  Int         @default(0)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Cíl zadaný v demu — drží se odděleně od plnohodnotných Goal záznamů
/// (zadání 8) a slouží k převzetí do plné verze po zaplacení.
model DemoGoal {
  id         String   @id @default(cuid())
  title      String
  targetDate DateTime @db.Date
  locale     String
  /// Na jakou jednotku byl cíl rozložen: year / month / week.
  /// Volí se podle délky horizontu — desetiletý cíl se rozpadá na roky,
  /// třítýdenní na týdny.
  level      String   @default("month")
  /// Rozpad nejvyšší úrovně tak, jak ho vrátila AI.
  periods    Json
  /// Hash IP pro rate limiting a antifraud — neukládáme IP v čitelné podobě.
  ipHash     String?
  /// Po převzetí do plné verze odkaz na vzniklý cíl.
  claimedByGoalId String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Záznam zásahů provozovatele
// ---------------------------------------------------------------------------

/// Co provozovatel udělal se zákaznickým účtem.
///
/// Do logu kontejneru se to psalo taky, jenže ten se po čase přetáčí —
/// a záznam, který zmizí, není záznam. Tohle je jediný způsob, jak po
/// měsících doložit, komu a proč byl přidělen bezplatný přístup.
///
/// Pole se schválně jmenuje , ne : pole s názvem 
/// se v databázi automaticky šifrují a tenhle záznam šifrovaný být nemá,
/// aby se dal číst i při řešení sporu.
model AdminAuditEvent {
  id           String   @id @default(cuid())
  /// Kdo zásah provedl. E-mail, ne odkaz na účet — správce se pozná
  /// podle seznamu v prostředí a účet mít vůbec nemusí.
  adminEmail   String
  /// GRANT_ACCESS | REVOKE_ACCESS
  action       String
  targetUserId String
  detail       String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}
