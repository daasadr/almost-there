# Podpisový klíč pro Google Play.
#
# Zkopíruj na keystore.properties (bez .example) a vyplň. Ten soubor je
# v .gitignore a do repozitáře se nikdy nedostane — hesla si do něj napiš
# sama, neposílej je nikam jinam.
#
# Klíč se vyrábí jednou. Zálohuj soubor .jks i hesla mimo tenhle počítač;
# Google Play přijímá aktualizace jen podepsané tím samým klíčem, takže po
# jeho ztrátě se aplikace nedá aktualizovat vůbec — jde jen vydat znovu pod
# novým názvem a přijít o všechny uživatele.
#
# Vytvoření (spusť z adresáře android/, heslo si vymysli a zapiš do správce
# hesel — keytool se na něj zeptá dvakrát):
#
#   keytool -genkeypair -v -keystore almostthere-release.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias almostthere
#
# Podepsaný balíček pro Play pak vznikne příkazem:
#
#   ./gradlew bundleRelease
#
# a najdeš ho v android/app/build/outputs/bundle/release/app-release.aab

storeFile=almostthere-release.jks
storePassword=
keyAlias=almostthere
keyPassword=
