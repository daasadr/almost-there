# nginx konfigurace pro AlmostThere na Hetzner VPS.
#
# Umísti jako /etc/nginx/sites-available/almostthere a nalinkuj do
# sites-enabled. TLS certifikát vystaví certbot
# (viz README, sekce Nasazení) — po jeho spuštění si tenhle soubor
# certbot sám doplní o cesty k certifikátům.

# Kam nginx posílá požadavky. Port musí sedět s APP_PORT v .env — nginx
# si ho z .env nepřečte, je to jediné místo, kde ho ladíš ručně. Když na
# serveru běží víc projektů a 3000 je obsazený, změň ho tady i tam.
upstream almostthere_app {
    # Musí sedět s APP_PORT v .env — na tomhle serveru 3002,
    # protože 3000 a 3001 drží jiný projekt.
    server 127.0.0.1:3002;
    keepalive 16;
}

# Rate limit na demo endpoint. Aplikace má vlastní strop na IP, tohle je
# druhá vrstva před ní — sem se útok nedostane ani k Node procesu.
limit_req_zone $binary_remote_addr zone=demo_api:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name almost-there.eu www.almost-there.eu;

    # Certbot si sem doplní přesměrování na HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # HTTP/2 zapnuté starším zápisem. Samostatná direktiva `http2 on;`
    # existuje až od nginx 1.25.1 a na starších verzích shodí konfiguraci
    # chybou "unknown directive". Tenhle tvar funguje na obou; na novém
    # nginxu jen upozorní, že je zastaralý.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name almost-there.eu www.almost-there.eu;

    # --- TLS (doplní certbot) ---
    # ssl_certificate     /etc/letsencrypt/live/almost-there.eu/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/almost-there.eu/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # --- Bezpečnostní hlavičky ---
    # HSTS je schválně zakomentované. Až ověříš, že HTTPS funguje, odkomentuj —
    # jakmile ho prohlížeč jednou dostane, rok odmítne jít na HTTP, a kdyby
    # certifikát nefungoval, byl by web nedostupný.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Vygenerované plány bývají delší; komprese se tu vyplatí.
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 2m;

    # --- Statické soubory Next.js ---
    # Mají hash v názvu, takže je lze cachovat natrvalo.
    location /_next/static/ {
        proxy_pass http://almostthere_app;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # --- Demo endpoint ---
    # Generování plánu trvá desítky sekund, výchozí 60s timeout by ho uřízl.
    location /api/demo {
        limit_req zone=demo_api burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://almostthere_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }

    # --- Zbytek aplikace ---
    location / {
        proxy_pass http://almostthere_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Bez těchhle hlaviček by aplikace viděla jako IP všech návštěvníků
        # adresu nginxu a rate limit by přestal dávat smysl.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
