# nginx konfigurace pro AlmostThere na Hetzner VPS.
#
# Umísti jako /etc/nginx/sites-available/almostthere a nalinkuj do
# sites-enabled. Doménu nahraď svou. TLS certifikát vystaví certbot
# (viz README, sekce Nasazení) — po jeho spuštění si tenhle soubor
# certbot sám doplní o cesty k certifikátům.

# Rate limit na demo endpoint. Aplikace má vlastní strop na IP, tohle je
# druhá vrstva před ní — sem se útok nedostane ani k Node procesu.
limit_req_zone $binary_remote_addr zone=demo_api:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name almostthere.app www.almostthere.app;

    # Certbot si sem doplní přesměrování na HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name almostthere.app www.almostthere.app;

    # --- TLS (doplní certbot) ---
    # ssl_certificate     /etc/letsencrypt/live/almostthere.app/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/almostthere.app/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # --- Bezpečnostní hlavičky ---
    # HSTS zapni až když víš, že HTTPS funguje — vrátit se zpět nejde hned.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Vygenerované plány bývají delší; komprese se tu vyplatí.
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 2m;

    # --- Statické soubory Next.js ---
    # Mají hash v názvu, takže je lze cachovat natrvalo.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # --- Demo endpoint ---
    # Generování plánu trvá desítky sekund, výchozí 60s timeout by ho uřízl.
    location /api/demo {
        limit_req zone=demo_api burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }

    # --- Zbytek aplikace ---
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Bez těchhle hlaviček by aplikace viděla jako IP všech návštěvníků
        # adresu nginxu a rate limit by přestal dávat smysl.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
