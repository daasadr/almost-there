# nginx konfigurace pro AlmostThere na Hetzner VPS.
#
# Umísti jako /etc/nginx/sites-available/almostthere a nalinkuj do
# sites-enabled. TLS certifikát vystaví certbot
# (viz README, sekce Nasazení) — po jeho spuštění si tenhle soubor
# certbot sám doplní o cesty k certifikátům.

# Kam nginx posílá požadavky. Port musí sedět s APP_PORT v .env — nginx
# si ho z .env nepřečte, je to jediné místo, kde ho ladíš ručně. Když na
# serveru běží víc projektů a 3000 je obsazený, změň ho tady i tam.
upstream almostthere_app {
    # Musí sedět s APP_PORT v .env — na tomhle serveru 3002,
    # protože 3000 a 3001 drží jiný projekt.
    server 127.0.0.1:3002;
    keepalive 16;
}

# Rate limit na demo endpoint. Aplikace má vlastní strop na IP, tohle je
# druhá vrstva před ní — sem se útok nedostane ani k Node procesu.
limit_req_zone $binary_remote_addr zone=demo_api:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name almost-there.eu www.almost-there.eu;

    # Certbot si sem doplní přesměrování na HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Rovnou na tvar bez www, ne přes $host. Jinak by z http://www vedly
    # dva skoky a vyhledávač počítá každý skok jako ztrátu.
    location / {
        return 301 https://almost-there.eu$request_uri;
    }
}

# --- www → bez www ---
#
# Obojí dřív vracelo obsah a pro vyhledávač to byly dva weby s naprosto
# stejným obsahem. Ani jeden pak nedostane plnou váhu a odkazy zvenčí se
# rozdělí mezi dvě adresy. Tvar bez www je ten hlavní — je v kanonických
# adresách i v mapě webu, takže musí vyhrát i tady.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name www.almost-there.eu;

    ssl_certificate     /etc/letsencrypt/live/almost-there.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/almost-there.eu/privkey.pem;

    return 301 https://almost-there.eu$request_uri;
}

server {
    # HTTP/2 zapnuté starším zápisem. Samostatná direktiva `http2 on;`
    # existuje až od nginx 1.25.1 a na starších verzích shodí konfiguraci
    # chybou "unknown directive". Tenhle tvar funguje na obou; na novém
    # nginxu jen upozorní, že je zastaralý.
    listen 443 ssl http2;
    # Na IPv6 schválně bez http2 — jiný projekt na serveru už pro [::]:443
    # nastavil vlastní volby a nginx by hlásil "protocol options redefined".
    listen [::]:443 ssl;
    # Jen tvar bez www — ten s www má vlastní blok výš, který přesměrovává.
    server_name almost-there.eu;

    # --- TLS ---
    # Cesty odpovídají certifikátu vydanému příkazem z README. Tuhle
    # konfiguraci nasazuj až potom — bez existujícího certifikátu nginx
    # blok s `listen ... ssl` nenačte a shodí se celá konfigurace.
    ssl_certificate     /etc/letsencrypt/live/almost-there.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/almost-there.eu/privkey.pem;

    # Nastavení píšeme sami, ne přes include od certbotu — ten vzniká jen
    # při použití nginx pluginu a my certifikát vydáváme přes webroot.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:AlmostThereSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --- Bezpečnostní hlavičky ---
    # HSTS je schválně zakomentované. Až ověříš, že HTTPS funguje, odkomentuj —
    # jakmile ho prohlížeč jednou dostane, rok odmítne jít na HTTP, a kdyby
    # certifikát nefungoval, byl by web nedostupný.
    # Prohlížeč si po první návštěvě zapamatuje, že sem chodí jen přes HTTPS,
    # a odmítne i pokus o nešifrované spojení. Zapíná se až po vydání
    # certifikátu — dřív by si prohlížeč zapamatoval nedostupný web.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Vygenerované plány bývají delší; komprese se tu vyplatí.
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 2m;

    # --- Statické soubory Next.js ---
    # Mají hash v názvu, takže je lze cachovat natrvalo.
    location /_next/static/ {
        proxy_pass http://almostthere_app;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # --- Service worker ---
    # Nesmí se cachovat. Prohlížeč si ho drží a řídí se jím; kdyby dostal
    # starou verzi, zůstaly by v telefonech kusy předchozího buildu i po
    # nasazení nového. Soubor je malý, takže se nic neztrácí.
    location = /sw.js {
        proxy_pass http://almostthere_app;
        proxy_set_header Host $host;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # --- Demo endpoint ---
    # Generování plánu trvá desítky sekund, výchozí 60s timeout by ho uřízl.
    location /api/demo {
        limit_req zone=demo_api burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://almostthere_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }

    # --- Generování plánu za přihlášením ---
    # Založení cíle je jedno volání modelu, ale dorozpad na dny jich může
    # zřetězit tři (měsíce → týdny → dny). Proto delší strop než u dema.
    # Rate limit tu není: tyhle endpointy jsou za přihlášením a za
    # předplatným a mají vlastní měsíční strop spotřeby.
    location ~ ^/api/(goals|tasks|images) {
        # Nahrávané fotky z telefonu bývají několik megabajtů. Výchozí
        # limit nginxu je 1 MB a odmítl by je dřív, než dojdou k aplikaci.
        client_max_body_size 10m;

        proxy_pass http://almostthere_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 330s;
        proxy_send_timeout 330s;
        proxy_buffering off;
    }

    # --- Zbytek aplikace ---
    location / {
        proxy_pass http://almostthere_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Bez těchhle hlaviček by aplikace viděla jako IP všech návštěvníků
        # adresu nginxu a rate limit by přestal dávat smysl.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
