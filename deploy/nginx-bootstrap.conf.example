# ZAVÁDĚCÍ nginx konfigurace — jen HTTP, používá se jednou před vydáním
# certifikátu a pak se nahradí ostrou nginx.conf.example.
#
# K čemu je: ostrá konfigurace má blok pro port 443 s `listen ... ssl`,
# a nginx bez existujícího certifikátu takový blok odmítne načíst chybou
#   no "ssl_certificate" is defined for the "listen ... ssl" directive
# Certbot přitom potřebuje běžící nginx, aby si přes něj ověřil doménu.
# Tahle konfigurace ten kruh rozetne: obslouží ověřovací výzvu na portu 80
# a zároveň už normálně servíruje aplikaci.
#
# Postup je v README, sekce Nasazení.

upstream almostthere_app {
    # Musí sedět s APP_PORT v .env.
    server 127.0.0.1:3002;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=demo_api:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name almost-there.eu www.almost-there.eu;

    # Sem si Let's Encrypt sáhne pro ověření, že doména je tvoje.
    # Musí zůstat i v ostré konfiguraci, jinak selže obnova certifikátu.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location /_next/static/ {
        proxy_pass http://almostthere_app;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Generování plánu trvá desítky sekund, výchozí 60s timeout by ho uřízl.
    location /api/demo {
        limit_req zone=demo_api burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://almostthere_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://almostthere_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
